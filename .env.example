# MCPCONECCT Configuration

# Burp Suite Upstream Proxy
# Set to 'true' to route all MCP search/export requests through Burp Suite (http://127.0.0.1:8080)
BURP_PROXY_ENABLED=false
BURP_PROXY_URL=http://127.0.0.1:8080
DISABLE_SSL_VERIFY=true

# Optional Burp Suite CA certificate path (if DISABLE_SSL_VERIFY is false)
# BURP_CA_BUNDLE=/path/to/cacert.der

# HTTP Request Timeout
HTTP_TIMEOUT=30.0

# Optional API Keys (if using direct APIs alongside browser sessions)
# ELSEVIER_API_KEY=
# ELSEVIER_INST_TOKEN=
# SPRINGER_API_KEY=
# WOS_STARTER_API_KEY=
# IEEE_API_KEY=
